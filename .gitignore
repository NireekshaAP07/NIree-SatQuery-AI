# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/

# Environment secrets
.env
satquery_backend/.env
!.env.example
!satquery_backend/.env.example

# Docker secrets — actual values, never commit
secrets/*.txt

# Temporary and local storage
satquery_backend/storage/uploads/*
!satquery_backend/storage/uploads/.gitkeep
satquery_backend/storage/previews/*
!satquery_backend/storage/previews/.gitkeep
satquery_backend/storage/*.db
storage/uploads/*
storage/previews/*
storage/*.db

# OS
.DS_Store

# Oracle production env
.env.prod

# ── ML data, checkpoints, weights — NEVER commit ─────────────────────────────
# Raw downloaded datasets (BigEarthNet tarballs + extracted splits)
data/raw/
# HuggingFace datasets built by build_vlm_dataset.py
data/derived/
# Trained LoRA weights (ignore other experiment weights, but track the trained adapter)
data/weights/*
!data/weights/satquery-paligemma-lora/
# Intermediate training checkpoints
data/tmp/
# Auto-generated evaluation reports
data/reports/
