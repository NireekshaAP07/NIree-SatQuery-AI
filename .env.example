# SatQuery AI — Environment Variables Template
# Copy this file to .env and fill in your values before running.
# NEVER commit your actual .env file to version control.

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=satquery
POSTGRES_DB=satquery_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://satquery:your_secure_password_here@db:5432/satquery_db
# NOTE: POSTGRES_PASSWORD is NOT set here — it is injected via Docker Secret.
#       See secrets/postgres_password.txt

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE (MinIO / S3 Distributed Object Storage or Local Filesystem)
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_BACKEND=s3             # Options: local | s3
STORAGE_LOCAL_ROOT=./data      # Local cache / fallback directory

# S3 / MinIO Settings:
# Inside Docker Compose: MinIO is at http://minio:9000
# Outside Docker (local host): MinIO is at http://localhost:9000
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=satquery
S3_REGION=us-east-1
# S3_PUBLIC_ENDPOINT_URL=https://your-domain.com/s3  # Optional public URL for browser presigned links
# NOTE: S3_ACCESS_KEY and S3_SECRET_KEY are injected via Docker Secrets in production.
#       See secrets/minio_root_user.txt and secrets/minio_root_password.txt

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# SECRET_KEY: In production, inject via secrets/secret_key.txt (Docker Secret).
#   For local dev only, set it here:
# SECRET_KEY=replace_with_a_long_random_secret_key_at_least_64_chars
#   Generate: python -c "import secrets; print(secrets.token_hex(64))"

# ALLOWED_ORIGINS — set to your actual deployment URL in production.
# Platform examples:
#   Vercel:   https://your-app.vercel.app
#   Netlify:  https://your-app.netlify.app
#   Render:   https://your-app.onrender.com
# In production, HTTP, localhost, and wildcard '*' are REJECTED at startup.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# DOCKER SECRETS — Production Secrets Management
# ─────────────────────────────────────────────────────────────────────────────
# The following secrets are NOT stored in this file for production.
# They are injected as in-memory Docker secrets from the secrets/ directory.
# The app reads /run/secrets/<name> first, then falls back to the env var.
#
# Secret files to fill before deploying:
#   secrets/postgres_password.txt   — PostgreSQL password
#   secrets/secret_key.txt          — JWT signing key (min 64 chars)
#   secrets/openai_api_key.txt      — OpenAI API key
#   secrets/gemini_api_key.txt      — Gemini / Google API key
#   secrets/minio_root_user.txt     — MinIO root username (admin)
#   secrets/minio_root_password.txt — MinIO root password (min 8 chars)
#
# For LOCAL DEV ONLY — you can set them here as env vars instead:
# SECRET_KEY=your_dev_secret
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIzaSy...
# GEMINI_API_KEY=AIzaSy...
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ─────────────────────────────────────────────────────────────────────────────
# ── MODEL INJECTION POINT ────────────────────────────────────────────────────
# Set the VLM checkpoint name here when you decide on the model.
# ─────────────────────────────────────────────────────────────────────────────
VLM_MODEL_NAME=PLACEHOLDER_SET_WHEN_MODEL_IS_CHOSEN
VLM_DEVICE=cpu                 # Options: cpu | cuda | mps

# ─────────────────────────────────────────────────────────────────────────────
# ── LLM / ORCHESTRATOR INJECTION POINT ───────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai            # Options: openai | gemini | ollama
LLM_MODEL=gpt-4o
# OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
# ── GEMINI VLM CONFIGURATION ─────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development            # Options: development | production
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
ALLOWED_IMAGE_FORMATS=tif,tiff,jp2,img,hdf5,nc,png,jpg,jpeg
